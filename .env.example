PORT=3000
# Desenvolvimento: endereço exato utilizado no navegador.
APP_URL=http://localhost:3000
DATABASE_URL=mysql://plantao:troque-a-senha@localhost:3306/plantaozen
# Produção exige APP_URL=https://seu-dominio e banco com acesso restrito/TLS.
# Push Android opcional: mantenha vazio até concluir a configuração.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Somente se o servidor estiver protegido atrás desse número exato de proxies.
TRUST_PROXY_HOPS=0

# Recuperação por e-mail (Resend): use remetente de domínio verificado.
RESEND_API_KEY=
PASSWORD_RESET_FROM=Plantao Zen <seguranca@seu-dominio.com>
# Obrigatória para habilitar TOTP. Gerar: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
